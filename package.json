{
  "name": "halder-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --import tsx server/src/server.ts",
    "server:seed": "node --import tsx server/src/db/seed.ts",
    "server:test": "node --import tsx server/tests/backend.test.ts",
    "server:security": "node --import tsx server/tests/security_matrix.test.ts",
    "server:load10k": "node --import tsx server/tests/load_test_10k.ts",
    "server:load100k": "node --import tsx server/tests/load_test_100k.ts",
    "server:geo": "node --import tsx server/tests/geo_logistics.test.ts",
    "server:earnings": "node --import tsx server/tests/farmer_earnings.test.ts",
    "server:kyc-push": "node --import tsx server/tests/kyc_push.test.ts",
    "server:chat-i18n": "node --import tsx server/tests/chat_i18n.test.ts",
    "server:chat-adversarial": "node --import tsx server/tests/adversarial_chat_stress.test.ts",
    "server:profile": "node --import tsx server/tests/profile_system.test.ts",
    "server:phonepe": "node --import tsx server/tests/phonepe_payment.test.ts",
    "server:multi-gateway": "node --import tsx server/tests/multi_gateway_payment.test.ts",
    "server:production": "node --import tsx server/tests/production_phases.test.ts",
    "server:e2e": "node --import tsx server/tests/e2e_journey.ts",
    "server:comprehensive": "node --import tsx server/tests/comprehensive_modules.test.ts",
    "server:gates": "node --import tsx server/tests/launch_gate_scenarios.test.ts",
    "server:concurrency": "node --import tsx server/tests/concurrency_load.test.ts",
    "server:backup": "node --import tsx server/scripts/backup.ts",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "build:android": "npm run build && cap sync android",
    "build:release-apk": "npm run build && cap sync android && cd android && gradlew.bat assembleRelease",
    "build:release-aab": "npm run build && cap sync android && cd android && gradlew.bat bundleRelease",
    "build:aab": "npm run build && cap sync android && cd android && gradlew.bat bundleRelease",
    "build:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.39.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^11.1.0",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}

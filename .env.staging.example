# SPDX-License-Identifier: Apache-2.0
# HALDER Staging Environment Configuration Template

# Server & Network Configuration
NODE_ENV=staging
PORT=5000
STAGING_DOMAIN=staging.halder.example.com
CORS_ORIGIN=https://staging.halder.example.com

# Authentication (DO NOT USE PRODUCTION SECRETS)
JWT_SECRET=generate_a_64_char_secure_random_string_for_staging
JWT_EXPIRES_IN=7d

# Database Storage (Persistent volume path)
DB_PATH=/app/data/halder_staging.db

# Storage Directories
UPLOAD_DIR=/app/uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

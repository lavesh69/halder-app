# HALDER Production Environment Configuration Template
PORT=5000
NODE_ENV=production
JWT_SECRET=your_strong_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
DB_PATH=./server/halder.db
# Supabase Cloud PostgreSQL (Primary persistent DB for Vercel & production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SYNC_SECRET=
# Turso Cloud SQLite (Optional alternative persistent DB)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CORS_ORIGIN=https://halder.local,http://localhost:5173,http://localhost:4173
UPLOAD_DIR=./server/uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# HALDER Production Environment Configuration Template
PORT=5000
NODE_ENV=production
JWT_SECRET=your_strong_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
DB_PATH=./server/halder.db
CORS_ORIGIN=https://halder.local,http://localhost:5173,http://localhost:4173
UPLOAD_DIR=./server/uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
